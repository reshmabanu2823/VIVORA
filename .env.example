# Copy this file to .env and fill in your values. Never commit .env.

# LLM provider settings
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible API) | mock (no key, for testing the flow)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1   # only for the openai provider
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name_here
LLM_TEMPERATURE=0.4

# App settings
PORT=8000
FRONTEND_ORIGIN=http://localhost:5500
MAX_UPLOAD_MB=10
SESSION_TIMEOUT_MIN=60
NUM_QUESTIONS_DEFAULT=5
SILENCE_NUDGE_SECONDS=8
MAX_NUDGES_PER_QUESTION=2
LLM_TIMEOUT_SEC=30
TURNS_PER_MINUTE_LIMIT=12
